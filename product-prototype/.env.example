DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Tencent Cloud Node HTTP backend. Keep this file free of real secrets.
APP_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=data/qianhai.sqlite
MIGRATIONS_PATH=migrations
CORS_ALLOWED_ORIGINS=
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=

# Production requires Authorization: Bearer <HS256 JWT>. Direct identity
# headers are accepted only for an explicit local/test process.
ALLOW_TEST_AUTH_HEADERS=false
ALLOW_DEMO_ACTOR=false
# Presentation fallback is accepted in production only for the fixed
# org-demo-guikesong tenant. Never point this mode at a real organization.
ALLOW_PRESENTATION_ACTOR=false
DEFAULT_ORGANIZATION_ID=org-demo-guikesong
DEFAULT_NEW_USER_ROLE_ID=role-owner
DEMO_ACTOR_USER_ID=user-demo-local
DEMO_ACTOR_EXTERNAL_ID=demo-local-user
DEMO_ACTOR_EMAIL=demo@example.invalid
DEMO_ACTOR_NAME=本地 Demo 用户
