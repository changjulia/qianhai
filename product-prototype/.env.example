DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Request identity. Production requests must contain oai-authenticated-user-* headers.
# Demo fallback is accepted only when APP_ENV is development/local/test AND this flag is true.
APP_ENV=development
ALLOW_DEMO_ACTOR=true
DEFAULT_ORGANIZATION_ID=org-demo-guikesong
DEFAULT_NEW_USER_ROLE_ID=role-owner
DEMO_ACTOR_USER_ID=user-demo-local
DEMO_ACTOR_EXTERNAL_ID=demo-local-user
DEMO_ACTOR_EMAIL=demo@example.invalid
DEMO_ACTOR_NAME=本地 Demo 用户
